#!/bin/sh
set -eu

if [ ! -e node_modules ]; then
    if [ "${CHECK_WRITABLE:-0}" = 1 ]; then
        cp -R /opt/check/node_modules node_modules
    else
        ln -s /opt/check/node_modules node_modules
    fi
fi

task=${1:-check}
shift || true

case "$task" in
    check)
        for category in $CHECK_TASKS; do
            /opt/check/run "$category"
        done
        ;;
    lint)
        bash -n tests/container/run tests/container/staged tests/container/staged-git
        sh -n tests/container/check
        shellcheck -x -P SCRIPTDIR tests/container/run tests/container/staged tests/container/staged-git tests/container/check
        npm run lint:internal
        markdownlint-cli2
        ;;
    test)
        printf '%s\n' 'No test suite is declared.' >&2
        exit 2
        ;;
    build)
        npm run build:prod:internal
        ;;
    exec)
        if [ "$#" -gt 0 ]; then
            exec "$@"
        fi
        if [ -z "${COMMAND:-}" ]; then
            printf '%s\n' 'Set COMMAND for make exec.' >&2
            exit 2
        fi
        exec sh -ec "$COMMAND"
        ;;
    *)
        printf '%s\n' "Unsupported check task: $task" >&2
        exit 2
        ;;
esac
