#!/usr/bin/env bash
set -euo pipefail
checkout=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd -P)
stock_entrypoint_path=${BASH_SOURCE[0]}
stock_entrypoint_hash=$(sha256sum "${stock_entrypoint_path}" | cut -d ' ' -f1)
# shellcheck source=tests/container/stock
source "${checkout}/tests/container/stock"
action=${1:-check}
case "${action}" in check|lint|test|build) ;; *) printf 'Unknown stock check: %s\n' "${action}" >&2; exit 2 ;; esac
if (( $# > 1 )); then printf '%s\n' 'Stock checks do not accept extra arguments.' >&2; exit 2; fi
if [[ ${action} == test ]]; then printf '%s\n' 'No test suite is declared.' >&2; exit 2; fi
native_arguments=("${action}")
: "${NODE_IMAGE:?The Makefile declares NODE_IMAGE}"
: "${SHELLCHECK_IMAGE:?The Makefile declares SHELLCHECK_IMAGE}"
stock_begin "${checkout}"
cd -- "${checkout}"
STOCK_OUTPUT_DIR=
node_image=
shellcheck_image=
stock_image node_image "${NODE_IMAGE}"
publish_dist() {
    local generated=$1 stage backup entry relative validation_list
    [[ $(pwd -P) == "${checkout}" && $(realpath -e -- "${checkout}") == "${checkout}" ]]
    [[ ${generated} == "${scratch}/build-output" && -d ${generated} && ! -L ${generated} && ! -L dist ]]
    [[ -z $(git ls-files -- dist) && -z $(git ls-tree -r --name-only HEAD -- dist) ]]
    git check-ignore --quiet --no-index dist/
    validation_list=$(mktemp "${scratch}/publish-list.XXXXXXXX")
    find -P "${generated}" -print0 > "${validation_list}"
    [[ -n $(find -P "${generated}" -type f -print -quit) ]]
    while IFS= read -r -d '' entry; do
        [[ ! -L ${entry} && ( -f ${entry} || -d ${entry} ) ]]
        if [[ -f ${entry} ]]; then [[ $(stat -c %h -- "${entry}") == 1 ]]; fi
        relative=${entry#"${generated}"}
        if [[ -n ${relative} ]]; then git check-ignore --quiet --no-index "dist${relative}"; fi
    done < "${validation_list}"
    if [[ -e dist ]]; then
        [[ -d dist ]]
        find -P dist -print0 > "${validation_list}"
        while IFS= read -r -d '' entry; do
            [[ ! -L ${entry} && ( -f ${entry} || -d ${entry} ) ]]
            git check-ignore --quiet --no-index "${entry}"
        done < "${validation_list}"
    fi
    stage=$(mktemp -d .dist-stage.XXXXXXXX)
    cp -R -- "${generated}/." "${stage}/"
    find -P "${stage}" -type d -exec chmod u+rwx,go+rx,go-w {} +
    find -P "${stage}" -type f -exec chmod u+rw,go+r,go-w {} +
    backup=
    if [[ -e dist ]]; then
        backup=$(mktemp -d .dist-backup.XXXXXXXX)
        rmdir -- "${backup}"
        mv -- dist "${backup}"
    fi
    if mv -- "${stage}" dist; then
        if [[ -n ${backup} ]]; then find -P "${backup}" -depth -delete; fi
    else
        if [[ -n ${backup} ]]; then mv -- "${backup}" dist; fi
        return 1
    fi
}
build_output=
if [[ ${action} == build ]]; then
    build_output=${scratch}/build-output
    mkdir "${build_output}"
    STOCK_OUTPUT_DIR=${build_output}
fi
STOCK_OUTPUT_DIR=${STOCK_OUTPUT_DIR:-} STOCK_NETWORK=bridge stock_run "${node_image}" -- sh tests/container/node "${native_arguments[@]}"
if [[ ${action} == check || ${action} == lint ]]; then
    STOCK_NETWORK=bridge stock_run "${node_image}" -- sh tests/container/markdown
    shell_files=(tests/container/stock tests/container/check-stock tests/container/node tests/container/markdown)
    while IFS= read -r -d '' file; do
        if [[ ${file} == *.sh ]]; then shell_files+=("${file}"); fi
    done < "${scratch}/source.list"
    stock_image shellcheck_image "${SHELLCHECK_IMAGE}"
    stock_readonly "${shellcheck_image}" /bin/shellcheck -x -P SCRIPTDIR "${shell_files[@]}"
fi
stock_finish
if [[ -n ${build_output} ]]; then publish_dist "${build_output}"; fi
