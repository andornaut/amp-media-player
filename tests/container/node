#!/bin/sh
set -eu
action=${1:-check}
git config --global url.https://github.com/.insteadOf ssh://git@github.com/
git config --global --add url.https://github.com/.insteadOf git@github.com:
HUSKY=0 npm ci --ignore-scripts --maxsockets=1 --legacy-peer-deps --no-audit --no-fund >&2
lint() {
    for script in tests/container/stock tests/container/check-stock; do bash -n "$script"; done
    for script in tests/container/node tests/container/markdown; do sh -n "$script"; done
    npm run lint
}
test_suite() {
    printf '%s\n' 'No test suite is declared.' >&2
    return 2
}
build() {
    npm run build:prod
}
case "${1:-check}" in
    check)
        lint
        build
        ;;
    lint) lint ;;
    test) test_suite ;;
    build) build ;;
    *) exit 2 ;;
esac

if [ "$action" = build ]; then
    cp -R dist/. /outputs/
    find /outputs -mindepth 1 -type d -exec chmod a+rwx {} +
fi
